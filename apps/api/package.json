{
  "name": "@borradh-workspace/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "node ../../scripts/kill-port.mjs 3000 && env-cmd -f ../../.env -- nest start --watch --preserveWatchOutput",
    "dev": "node ../../scripts/kill-port.mjs 3000 && env-cmd -f ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "biome check src/ && node ../../scripts/lint/no-implicit-timezone.mjs tsconfig.app.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile dist/typecheck.tsbuildinfo",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:auth-integration": "jest --config jest.auth-integration.config.ts --runInBand",
    "test:eval-live": "env-cmd -f ../../.env tsx src/assistant/eval/run-controller-eval.ts",
    "gen:capability-manifest": "tsx src/architecture/generate-capability-manifest.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.36",
    "@anthropic-ai/sdk": "0.91.1",
    "@borradh-workspace/ai": "workspace:*",
    "@borradh-workspace/auth": "workspace:*",
    "@borradh-workspace/contracts": "workspace:*",
    "@borradh-workspace/database": "workspace:*",
    "@borradh-workspace/email": "workspace:*",
    "@borradh-workspace/env": "workspace:*",
    "@borradh-workspace/features": "workspace:*",
    "@borradh-workspace/http": "workspace:*",
    "@borradh-workspace/integrations": "workspace:*",
    "@borradh-workspace/labels": "workspace:*",
    "@borradh-workspace/observability": "workspace:*",
    "@borradh-workspace/redis": "workspace:*",
    "@borradh-workspace/storage": "workspace:*",
    "@borradh-workspace/web-shared": "workspace:*",
    "@bull-board/api": "^5.21.1",
    "@bull-board/express": "^5.21.1",
    "@napi-rs/canvas": "^1.0.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@swc/helpers": "~0.5.11",
    "ai": "^6.0.104",
    "bullmq": "^5.48.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "expo-server-sdk": "^3.13.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "nestjs-zod": "^5.0.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "zod": "^4.2.1"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.0.4",
    "@img/sharp-linux-x64": "0.33.5",
    "@napi-rs/canvas-linux-x64-gnu": "1.0.3"
  },
  "devDependencies": {
    "@better-auth/utils": "^0.5.0",
    "@nestjs/cli": "^11.0.14",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.5.7",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "fflate": "0.8.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "tsconfig-paths": "^4.2.0"
  }
}
