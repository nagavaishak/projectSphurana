{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": ".tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "emitDeclarationOnly": false,
    "declaration": true,
    "baseUrl": ".",
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.integration.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.int-spec.ts",
    "src/**/*.test.ts",
    "src/_integration/**/*.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/contracts/tsconfig.lib.json"
    },
    {
      "path": "../../packages/ai/tsconfig.lib.json"
    },
    {
      "path": "../../packages/http/tsconfig.lib.json"
    },
    {
      "path": "../../packages/integrations/tsconfig.lib.json"
    },
    {
      "path": "../../packages/storage/tsconfig.lib.json"
    },
    {
      "path": "../../packages/redis/tsconfig.lib.json"
    },
    {
      "path": "../../packages/observability/tsconfig.lib.json"
    },
    {
      "path": "../../packages/features/tsconfig.lib.json"
    },
    {
      "path": "../../packages/env/tsconfig.lib.json"
    },
    {
      "path": "../../packages/email/tsconfig.lib.json"
    },
    {
      "path": "../../packages/database/tsconfig.lib.json"
    },
    {
      "path": "../../packages/auth/tsconfig.lib.json"
    }
  ]
}
