{
  "name": "@borradh-workspace/app-e2e",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:baseline": "eslint src --suppress-all",
    "lint:prune": "eslint src --prune-suppressions",
    "e2e": "npx playwright test",
    "e2e:ui": "PW_SKIP_DEPS=1 npx playwright test --ui",
    "e2e:headed": "npx playwright test --headed",
    "e2e:debug": "npx playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:auth": "npx playwright test --project=auth-tests",
    "e2e:smoke": "npx playwright test --project=smoke-tests",
    "e2e:authenticated": "npx playwright test --project=authenticated",
    "e2e:real": "npx playwright test --project=real-e2e",
    "e2e:connected": "npx playwright test --project=connected",
    "e2e:connected-ads": "npx playwright test --project=connected-ads --workers=1",
    "e2e:connected-chatbot": "npx playwright test --project=connected-chatbot --workers=1",
    "e2e:journeys": "npx playwright test --project=journey-tests",
    "e2e:setup": "npx playwright test --project=setup-bare"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@better-auth/utils": "^0.5.0",
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.39.0",
    "eslint-plugin-playwright": "^2.10.0",
    "typescript-eslint": "^8.63.0"
  }
}
