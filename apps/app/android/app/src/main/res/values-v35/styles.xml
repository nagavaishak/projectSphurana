<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 35+: avoid forced edge-to-edge so the WebView matches classic window insets
         (pairs with `WindowCompat.setDecorFitsSystemWindows` in MainActivity). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/status_bar_scrim</item>
        <item name="android:navigationBarColor">@color/navigation_bar_scrim</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
