---
/**
 * THE BRANCH CHOOSER — `/sites/{org}/book` AND `/sites/{org}/venue`.
 *
 * A customer arriving here has not chosen a branch and must not be assumed into
 * one. This is the one all-locations view in the public flow; from the moment
 * they pick, the branch is in the URL and everything downstream is scoped to it.
 *
 * ── WHY THIS IS AN `.astro` COMPONENT AND NOT AN ISLAND
 *
 * Zero `client:*`. The venue page next door renders through
 * `VenuePageIsland client:load`, so its HTML is an empty shell and a crawler —
 * or a customer on a slow connection, or anyone whose JS bundle fails — sees
 * nothing at all. That is a known defect (audit addendum D). This page is the
 * top of a clinic's booking funnel and the single most valuable page to have
 * indexed, so it renders its addresses and hours as bytes.
 *
 * That also means the payload is fetched in the ROUTE's frontmatter, not by a
 * hook in here, which is why nothing in this component touches
 * `components/booking/api.ts`.
 *
 * Every card links to `{basePath}/l/{branch}/…` via `micrositeLink`, so the
 * chooser works unchanged on the path tier today and on wildcard/custom hosts
 * later. Nothing here derives the org from `window.location` — there is no
 * `window`.
 *
 * ── TWO ENTRY POINTS, ONE COMPONENT
 *
 * `/book` and `/venue` both land a customer who has not chosen a branch, and
 * they ask the SAME question about the SAME cards. What differs is where the
 * card goes: from `/book` the next thing they want is a time, from `/venue` it
 * is that branch's page. `intent` carries that, rather than a second component
 * that would drift in layout, hours formatting and address handling.
 */
import { micrositeLink, type MicrositeOrgContext } from '@/lib/microsite-org';
import {
  type BookingChooserPayload,
  branchBookingPath,
  branchDirectionsUrl,
  branchVenuePath,
  formatBranchAddress,
  summariseOpeningHours,
} from './location-chooser';

interface Props {
  payload: BookingChooserPayload;
  orgContext: Pick<MicrositeOrgContext, 'basePath'>;
  /**
   * Set when the customer arrived on a legacy `/book/{serviceId}` link. It is
   * carried through the pick so they land on the service they clicked, inside
   * the branch they chose, rather than being dropped at the top of the wizard.
   */
  serviceId?: string;
  /**
   * Which surface the customer is entering. `book` (the default) sends each
   * card into that branch's wizard; `venue` sends it to that branch's page.
   *
   * Getting this wrong is not cosmetic: a customer on `/venue` reading about a
   * clinic and clicking a location expects to READ about that location, and
   * dropping them into a booking wizard reads as the site jumping ahead of
   * them.
   */
  intent?: 'book' | 'venue';
}

const { payload, orgContext, serviceId, intent = 'book' } = Astro.props;

const cards = payload.locations.map((location) => ({
  location,
  href: micrositeLink(
    orgContext,
    intent === 'venue'
      ? branchVenuePath(location.segment)
      : branchBookingPath(location.segment, serviceId)
  ),
  title: location.name ?? location.city ?? payload.organizationName,
  address: formatBranchAddress(location),
  hours: summariseOpeningHours(location.openingHours),
  directions: branchDirectionsUrl(location),
}));
---

<main class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
  <header class="mb-8 flex flex-col items-center gap-4 text-center">
    {
      payload.organizationLogo && (
        <img
          src={payload.organizationLogo}
          alt={payload.organizationName}
          width="64"
          height="64"
          class="h-16 w-16 rounded-full object-cover"
          loading="eager"
        />
      )
    }
    <div>
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        {intent === 'venue'
          ? payload.organizationName
          : `Book at ${payload.organizationName}`}
      </h1>
      <p class="text-muted-foreground mt-2 text-sm sm:text-base">
        Choose the location you'd like to visit.
      </p>
    </div>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2">
    {
      cards.map((card) => (
        <li class="bg-card text-card-foreground flex flex-col overflow-hidden rounded-xl border shadow-sm">
          {card.location.photo && (
            <img
              src={card.location.photo}
              alt=""
              width="640"
              height="360"
              class="h-40 w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          )}

          <div class="flex flex-1 flex-col gap-3 p-5">
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-lg font-semibold leading-tight">{card.title}</h2>
              {card.location.isPrimary && (
                <span class="bg-primary/10 text-primary shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium">
                  Main location
                </span>
              )}
            </div>

            {card.address && (
              <p class="text-muted-foreground text-sm">{card.address}</p>
            )}

            {card.hours.length > 0 && (
              <dl class="text-muted-foreground grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
                {card.hours.map((row) => (
                  <>
                    <dt class="font-medium">{row.days}</dt>
                    <dd>{row.hours}</dd>
                  </>
                ))}
              </dl>
            )}

            <div class="mt-auto flex flex-col gap-2 pt-2">
              <a
                href={card.href}
                class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center justify-center rounded-md px-4 text-sm font-medium transition-colors"
              >
                {intent === 'venue' ? 'View location' : 'Book here'}
              </a>
              {card.directions && (
                <a
                  href={card.directions}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground hover:text-foreground text-center text-sm underline underline-offset-4"
                >
                  Get directions
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</main>
