---
import { BLOCK_VARIANTS } from '@borradh-workspace/web-shared';
import type { MapLocationProps } from '@borradh-workspace/web-shared';
import { pickLocation, resolveVariant, type MicrositeData } from '../data';
import { editableAttrs } from '../edit/editable';

const VARIANTS = BLOCK_VARIANTS['map_location'];

/**
 * DATA-BOUND. `props` selects the location and what to show; the address, geo
 * and embed URL come from `data.locations`. The renderer never assembles a
 * maps URL — provider and key are a server concern, so `mapEmbedUrl` arrives
 * ready to use or the map is simply omitted.
 */
interface Props {
  props: MapLocationProps;
  variant: string;
  data: MicrositeData;
  /** True ONLY on a token-gated draft preview. Never on a published render. */
  editable?: boolean;
  blockId?: string;
}

const { props, variant, data, editable = false, blockId } = Astro.props;

/** §2: `title` only. The address, phone and email belong to the location. */
const attrs = (field: string) =>
  editableAttrs(editable, blockId, 'map_location', field);
const v = resolveVariant(variant, VARIANTS);

const location = pickLocation(data, props?.locationId);
const showAddress = props?.showAddress !== false;
const mapUrl =
  props?.showMap !== false && location?.mapEmbedUrl ? location.mapEmbedUrl : null;

const addressLines = showAddress ? (location?.addressLines ?? []) : [];
const hasAddressBlock =
  addressLines.length > 0 || (showAddress && (location?.phone || location?.email));

const title = props?.title?.trim();
const layout = mapUrl ? v : 'address-only';
---

{
  location && (hasAddressBlock || mapUrl) && (
    <section class:list={['ms-section', 'ms-map', `ms-map--${layout}`]}>
      <div class="ms-container ms-map__inner">
        {(title || hasAddressBlock) && (
          <div class="ms-map__copy">
            {title && <h2 class="ms-map__title" {...attrs('title')}>
                {title}
              </h2>}
            {addressLines.length > 0 && (
              <address class="ms-map__address">
                {addressLines.map((line) => (
                  <span>{line}</span>
                ))}
              </address>
            )}
            {showAddress && location.phone && (
              <p>
                <a href={`tel:${location.phone.replace(/\s+/g, '')}`}>
                  {location.phone}
                </a>
              </p>
            )}
            {showAddress && location.email && (
              <p>
                <a href={`mailto:${location.email}`}>{location.email}</a>
              </p>
            )}
            {location.directionsUrl && (
              <a
                class="ms-button ms-map__directions"
                href={location.directionsUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                Get directions
              </a>
            )}
          </div>
        )}

        {mapUrl && (
          <div class="ms-map__frame">
            {/*
              The map is an iframe below the fold, so it is lazy — a third-party
              embed loaded eagerly is the fastest way to lose the LCP budget.
            */}
            <iframe
              src={mapUrl}
              title={`Map showing ${location.name || data.businessName}`}
              width="640"
              height="420"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .ms-map {
    background: var(--brand-surface);
  }

  .ms-map__inner {
    display: grid;
    gap: calc(var(--ms-gap) * 1.25);
    align-items: center;
  }

  .ms-map__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 1rem;
  }

  .ms-map__address {
    display: grid;
    color: var(--brand-muted);
    font-style: normal;
  }

  .ms-map__copy p {
    margin-top: 0.375rem;
  }

  .ms-map__directions {
    margin-top: 1.25rem;
  }

  .ms-map__frame {
    border-radius: var(--ms-radius);
    overflow: hidden;
    background: var(--brand-subtle);
  }

  .ms-map__frame iframe {
    display: block;
    width: 100%;
    height: min(60vh, 26rem);
    border: 0;
  }

  @media (min-width: 48rem) {
    .ms-map--split .ms-map__inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }
</style>
