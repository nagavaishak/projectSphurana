---
import { BLOCK_VARIANTS } from '@borradh-workspace/web-shared';
import type { RichTextProps } from '@borradh-workspace/web-shared';
import { resolveVariant } from '../data';
import { editableAttrs } from '../edit/editable';
import { renderMarkdownSubset } from '../markdown';

const VARIANTS = BLOCK_VARIANTS['rich_text'];

interface Props {
  props: RichTextProps;
  variant: string;
  /** True ONLY on a token-gated draft preview. Never on a published render. */
  editable?: boolean;
  blockId?: string;
}

const { props, variant, editable = false, blockId } = Astro.props;
const v = resolveVariant(variant, VARIANTS);

/**
 * The markdown is escaped and re-expanded by `renderMarkdownSubset`, so this
 * `set:html` cannot emit author HTML — that is the point of the helper. Raw
 * HTML is the `custom_html` block, a later phase.
 */
const html = renderMarkdownSubset(props?.markdown);
const align = props?.align === 'center' ? 'center' : 'left';

/**
 * `markdown` is edited as PLAIN TEXT (§2): the syntax survives, the formatting
 * is not WYSIWYG. So in edit mode the block renders the SOURCE in a pre-wrap
 * box rather than the rendered HTML — a contenteditable over the rendered
 * output would have the user typing into `<strong>` elements and committing
 * text that no longer contains the markup they were looking at.
 */
const source = typeof props?.markdown === 'string' ? props.markdown : '';
const attrs = editableAttrs(editable, blockId, 'rich_text', 'markdown');
// PRESENCE, not truthiness: the marker's value is the empty string (it is a
// boolean attribute), so `!!attrs['data-ms-editable']` is always false.
const editing = 'data-ms-editable' in attrs;
---

{
  editing ? (
    <section class:list={['ms-section', 'ms-rich', `ms-rich--${v}`]}>
      <div
        class="ms-container ms-rich__body ms-rich__body--source"
        data-align={align}
        {...attrs}
      >
        {source}
      </div>
    </section>
  ) : (
    html && (
      <section class:list={['ms-section', 'ms-rich', `ms-rich--${v}`]}>
        <div
          class="ms-container ms-rich__body"
          data-align={align}
          set:html={html}
        />
      </section>
    )
  )
}

<style>
  .ms-rich {
    background: var(--brand-surface);
  }

  .ms-rich__body {
    color: var(--brand-neutral);
  }

  /* Edit mode only: the markdown source, wrapped, monospaced enough to read. */
  .ms-rich__body--source {
    white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .ms-rich__body[data-align='center'] {
    text-align: center;
  }

  .ms-rich--narrow .ms-rich__body {
    max-width: 42rem;
  }

  .ms-rich__body :global(h2) {
    margin-top: 2rem;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
  }

  .ms-rich__body :global(h3),
  .ms-rich__body :global(h4),
  .ms-rich__body :global(h5),
  .ms-rich__body :global(h6) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
  }

  .ms-rich__body :global(h2:first-child),
  .ms-rich__body :global(h3:first-child) {
    margin-top: 0;
  }

  .ms-rich__body :global(p) {
    margin-top: 1rem;
  }

  .ms-rich__body :global(ul),
  .ms-rich__body :global(ol) {
    margin-top: 1rem;
    padding-left: 1.25rem;
  }

  .ms-rich__body :global(li) {
    margin-top: 0.375rem;
  }

  .ms-rich__body :global(strong) {
    color: var(--brand-primary);
  }

  .ms-rich__body :global(a) {
    color: var(--brand-accent);
    text-underline-offset: 0.15em;
  }
</style>
