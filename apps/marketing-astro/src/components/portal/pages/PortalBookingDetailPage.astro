---
/**
 * One booking. The appointment id was a TanStack route param
 * (`$appointmentId`); it is now an Astro dynamic segment, read server-side and
 * passed to the island as a prop.
 */
import { PortalBookingDetailIsland } from '../islands/booking-detail.island';
import { resolvePortalContextFromRequest } from '../portal-context';
import PortalLayout from '../PortalLayout.astro';
import PortalUnavailable from '../PortalUnavailable.astro';

interface Props {
  appointmentId: string;
}

const { appointmentId } = Astro.props;
const ctx = resolvePortalContextFromRequest(
  Astro.request,
  Astro.url,
  Astro.locals.microsite ?? null
);
---

{
  ctx && appointmentId ? (
    <PortalLayout title="Your booking">
      <PortalBookingDetailIsland
        client:load
        ctx={ctx}
        appointmentId={appointmentId}
      />
    </PortalLayout>
  ) : (
    <PortalUnavailable />
  )
}
