---
/**
 * Portal home. Rendered by BOTH route tiers — see src/pages/portal/index.astro
 * and src/pages/sites/[slug]/portal/index.astro, which are thin wrappers
 * around this one file so the two tiers can never drift apart.
 */
import { PortalHomeIsland } from '../islands/home.island';
import { resolvePortalContextFromRequest } from '../portal-context';
import PortalLayout from '../PortalLayout.astro';
import PortalUnavailable from '../PortalUnavailable.astro';

const ctx = resolvePortalContextFromRequest(
  Astro.request,
  Astro.url,
  Astro.locals.microsite ?? null
);
---

{
  ctx ? (
    <PortalLayout title="Your portal">
      <PortalHomeIsland client:load ctx={ctx} />
    </PortalLayout>
  ) : (
    <PortalUnavailable />
  )
}
