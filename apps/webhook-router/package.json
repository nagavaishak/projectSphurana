{
  "name": "@borradh-workspace/webhook-router",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --outDir dist",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@borradh-workspace/observability": "workspace:*",
    "@borradh-workspace/redis": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
