{
  "name": "@borradh-workspace/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "package.json", "drizzle"],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev": "docker-compose up postgres -d",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "pnpm build && drizzle-kit migrate",
    "db:push": "pnpm build && drizzle-kit push --force",
    "db:studio": "pnpm build && drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ --write",
    "rls:check-coverage": "node ../../scripts/rls/check-rls-coverage.mjs",
    "rls:check-coverage:warn": "node ../../scripts/rls/check-rls-coverage.mjs --warn"
  },
  "dependencies": {
    "@borradh-workspace/env": "workspace:*",
    "@borradh-workspace/labels": "workspace:*",
    "@borradh-workspace/video-templates": "workspace:*",
    "@paralleldrive/cuid2": "^3.0.4",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.7",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.7",
    "vitest": "^3.2.4"
  }
}
