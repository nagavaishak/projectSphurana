{
  "name": "@borradh-workspace/email",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev": "tsc --build tsconfig.lib.json --watch --preserveWatchOutput",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "biome check src/ --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@borradh-workspace/env": "workspace:*",
    "@borradh-workspace/redis": "workspace:*",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^1.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.14",
    "@types/react-dom": "~19.0.6",
    "vitest": "^3.2.4"
  }
}
