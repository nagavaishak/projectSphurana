      "default": "./dist/facebook/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js",
      "default": "./dist/email/index.js"
    },
    "./sms": {
      "types": "./dist/sms/index.d.ts",
      "import": "./dist/sms/index.js",
      "default": "./dist/sms/index.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp/index.d.ts",
      "import": "./dist/whatsapp/index.js",
      "default": "./dist/whatsapp/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js",
      "default": "./dist/voice/index.js"
    },
