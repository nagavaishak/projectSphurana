      "types": "./dist/loops/index.d.ts",
      "import": "./dist/loops/index.js",
      "default": "./dist/loops/index.js"
    },
    "./notion": {
      "types": "./dist/notion/index.d.ts",
      "import": "./dist/notion/index.js",
      "default": "./dist/notion/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "default": "./dist/shared/index.js"
    },
    "./domains": {
      "types": "./dist/vercel-domains/index.d.ts",
      "import": "./dist/vercel-domains/index.js",
      "default": "./dist/vercel-domains/index.js"
