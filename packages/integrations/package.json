  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev": "tsc --build tsconfig.lib.json --watch --preserveWatchOutput",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ --write"
  },
  "dependencies": {
    "@borradh-workspace/env": "workspace:*",
    "@borradh-workspace/http": "workspace:*",
    "@borradh-workspace/labels": "workspace:*",
    "@borradh-workspace/observability": "workspace:*",
    "@aws-sdk/client-ses": "^3.699.0",
    "@aws-sdk/client-sns": "^3.699.0",
    "@notionhq/client": "^2.2.15",
    "loops": "^4.0.0",
    "sharp": "^0.33.5",
    "stripe": "^17.5.0",
    "tslib": "^2.3.0",
    "zod": "^3.23.8"
