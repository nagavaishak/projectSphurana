      "types": "./dist/meta-capi/index.d.ts",
      "import": "./dist/meta-capi/index.js",
      "default": "./dist/meta-capi/index.js"
    },
    "./meta-domains": {
      "types": "./dist/meta-domains/index.d.ts",
      "import": "./dist/meta-domains/index.js",
      "default": "./dist/meta-domains/index.js"
    },
    "./meta-contract": {
      "types": "./dist/meta-contract/index.d.ts",
      "import": "./dist/meta-contract/index.js",
      "default": "./dist/meta-contract/index.js"
    },
    "./meta-messaging": {
      "types": "./dist/meta-messaging/index.d.ts",
