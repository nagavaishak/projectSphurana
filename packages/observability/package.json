{
  "name": "@borradh-workspace/observability",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "package.json"],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev": "tsc --build tsconfig.lib.json --watch --preserveWatchOutput",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "biome check src/ --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "@nestjs/common": "^11.0.0"
  },
  "dependencies": {
    "@borradh-workspace/env": "workspace:*",
    "@logtail/node": "^0.5.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@sentry/node": "^10.27.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.14.1",
    "tslib": "^2.3.0"
  }
}
