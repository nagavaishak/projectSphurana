{
  "name": "@borradh-workspace/runtime-config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": ["dist", "package.json"],
  "exports": {
    "./server": {
      "development": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "development": "./src/client.tsx",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./schema": {
      "development": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./env-map": {
      "development": "./src/env-map.ts",
      "types": "./dist/env-map.d.ts",
      "import": "./dist/env-map.js",
      "default": "./dist/env-map.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev": "tsc --build tsconfig.lib.json --watch --preserveWatchOutput",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ --write"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "~19.2.7",
    "jsdom": "~22.1.0",
    "react": "19.1.0"
  }
}
