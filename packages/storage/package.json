{
  "name": "@borradh-workspace/storage",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev": "tsc --build tsconfig.lib.json --watch --preserveWatchOutput",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.953.0",
    "@aws-sdk/cloudfront-signer": "3.953.0",
    "@aws-sdk/credential-providers": "3.953.0",
    "@aws-sdk/s3-request-presigner": "3.953.0",
    "@borradh-workspace/env": "workspace:*",
    "@borradh-workspace/http": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
