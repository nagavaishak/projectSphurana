{
  "name": "@borradh-workspace/video-processing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ffmpeg": {
      "types": "./dist/ffmpeg/index.d.ts",
      "import": "./dist/ffmpeg/index.js",
      "default": "./dist/ffmpeg/index.js"
    },
    "./whisper": {
      "types": "./dist/whisper/index.d.ts",
      "import": "./dist/whisper/index.js",
      "default": "./dist/whisper/index.js"
    },
    "./tts": {
      "types": "./dist/tts/index.d.ts",
      "import": "./dist/tts/index.js",
      "default": "./dist/tts/index.js"
    },
    "./remotion-lambda": {
      "types": "./dist/remotion-lambda/index.d.ts",
      "import": "./dist/remotion-lambda/index.js",
      "default": "./dist/remotion-lambda/index.js"
    },
    "./b-roll": {
      "types": "./dist/b-roll/index.d.ts",
      "import": "./dist/b-roll/index.js",
      "default": "./dist/b-roll/index.js"
    },
    "./captions": {
      "types": "./dist/captions/index.d.ts",
      "import": "./dist/captions/index.js",
      "default": "./dist/captions/index.js"
    },
    "./vision": {
      "types": "./dist/vision/index.d.ts",
      "import": "./dist/vision/index.js",
      "default": "./dist/vision/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rimraf dist",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ --write"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.953.0",
    "@aws-sdk/client-iam": "3.953.0",
    "@aws-sdk/client-lambda": "3.953.0",
    "@aws-sdk/client-s3": "3.953.0",
    "@aws-sdk/client-service-quotas": "3.953.0",
    "@aws-sdk/client-sts": "3.953.0",
    "@aws-sdk/credential-provider-ini": "3.953.0",
    "@aws-sdk/lib-storage": "3.953.0",
    "@aws-sdk/s3-request-presigner": "3.953.0",
    "@borradh-workspace/database": "workspace:*",
    "@borradh-workspace/env": "workspace:*",
    "@borradh-workspace/http": "workspace:*",
    "@borradh-workspace/storage": "workspace:*",
    "@remotion/captions": "4.0.386",
    "@remotion/lambda-client": "4.0.386",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "openai": "^6.16.0",
    "tslib": "^2.3.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@remotion/install-whisper-cpp": "4.0.386"
  },
  "devDependencies": {
    "@borradh-workspace/remotion": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@remotion/bundler": "4.0.386",
    "@remotion/lambda": "4.0.386",
    "@remotion/serverless-client": "4.0.386",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/fs-extra": "^11.0.4"
  }
}
