{
  "name": "@borradh-workspace/video-templates",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./music-registry": {
      "types": "./dist/music-registry.d.ts",
      "import": "./dist/music-registry.js",
      "default": "./dist/music-registry.js"
    },
    "./authority-1": {
      "types": "./dist/authority-1.d.ts",
      "import": "./dist/authority-1.js",
      "default": "./dist/authority-1.js"
    },
    "./authority-2": {
      "types": "./dist/authority-2.d.ts",
      "import": "./dist/authority-2.js",
      "default": "./dist/authority-2.js"
    },
    "./authority-3": {
      "types": "./dist/authority-3.d.ts",
      "import": "./dist/authority-3.js",
      "default": "./dist/authority-3.js"
    },
    "./before-after-1": {
      "types": "./dist/before-after-1.d.ts",
      "import": "./dist/before-after-1.js",
      "default": "./dist/before-after-1.js"
    },
    "./before-after-2": {
      "types": "./dist/before-after-2.d.ts",
      "import": "./dist/before-after-2.js",
      "default": "./dist/before-after-2.js"
    },
    "./before-after-3": {
      "types": "./dist/before-after-3.d.ts",
      "import": "./dist/before-after-3.js",
      "default": "./dist/before-after-3.js"
    },
    "./offer-square-1": {
      "types": "./dist/offer-square-1.d.ts",
      "import": "./dist/offer-square-1.js",
      "default": "./dist/offer-square-1.js"
    },
    "./educational-2": {
      "types": "./dist/educational-2.d.ts",
      "import": "./dist/educational-2.js",
      "default": "./dist/educational-2.js"
    },
    "./educational-3": {
      "types": "./dist/educational-3.d.ts",
      "import": "./dist/educational-3.js",
      "default": "./dist/educational-3.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "dev:packages": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "biome check src/ --write"
  },
  "dependencies": {
    "@borradh-workspace/labels": "workspace:*",
    "tslib": "^2.3.0",
    "zod": "^3.23.8"
  }
}
